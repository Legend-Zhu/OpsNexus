# OpsGaurd Worker agent configuration — safe-by-default.
# Copy to /etc/opsguard/agent-config.yaml on every swarm node and mount it into
# the worker container (see deploy/stack.yml).

worker:
  # auto: derive role from the swarm node (manager -> orchestration+MCP,
  #        worker -> local-only). Pin to manager/node to override.
  role: auto
  # Listen address of the node's local API (and, on managers, the orchestration API).
  listen: ":8080"
  # (node-role only) manager-role worker base URL for reporting.
  # managerURL: http://10.0.0.1:8080

# Monitoring events are POSTed to these URLs (manager-role worker only).
# Payload is the event JSON: {id, ts, service, type, level, msg, detail}.
# Fire-and-forget with exponential backoff retries; dedupe by id on the receiver.
webhooks:
  # - "http://opsguard-web:8080/api/v1/events"

# Bearer-token auth for the HTTP API and MCP endpoint.
# Enable in production — the API can run host commands. Tokens can also be
# distributed centrally via WORKER_TOKENS="name=secret,..." (env), which
# enables auth automatically.
auth:
  enabled: false
  # tokens map a name -> secret; the name becomes the audit actor:
  # tokens:
  #   admin: "change-me"
  #   ops: "change-me-too"

commandPolicy:
  # blacklist: reject commands matching `blacklist` substrings, allow the rest.
  # whitelist: allow only commands starting with a `whitelist` entry.
  mode: blacklist

  # Host command execution (exec_host_command, via nsenter). Requires the
  # worker to run privileged + pid=host. Default OFF — enable explicitly.
  allowHostExec: false

  # Container command execution (exec_in_container).
  allowContainerExec: true

  # Per-command timeout.
  timeout: 30s

  # Blacklist substrings (merged with the built-in dangerous set: rm -rf /,
  # shutdown, reboot, mkfs, dd to /dev/sd*, fork bombs, ...).
  blacklist:
    - "curl http://|sh"
    - "wget http://|sh"

  # Whitelist prefixes (used when mode: whitelist), e.g.:
  # whitelist:
  #   - "cat"
  #   - "ls"
  #   - "ps"
  #   - "df"
  #   - "free"
  #   - "docker ps"
  #   - "docker logs"
  #   - "systemctl status"
