# internet-proxy 运行配置模板——复制为 proxy.env 填真实值。
# 本服务只含飞书通知代理；LLM 等通用反代由 nginx 承担（见 nginx-llm.conf）。
# 注意：systemd EnvironmentFile 不支持行尾注释，注释必须独占一行。

# 监听地址。生产必须绑定内网侧 IP（网闸映射指向的那个），避免暴露公网。
LISTEN_NOTIFY=10.50.182.57:7072

# 飞书群机器人（自定义机器人 webhook，安全设置=加签）
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
FEISHU_WEBHOOK_SECRET=

# 飞书应用（error 级加急链路）：应用需已加入告警群并开通 im 消息权限
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=oc_xxxxxxxx
# 加急用户 user_id，逗号分隔
FEISHU_URGENT_USER_IDS=
