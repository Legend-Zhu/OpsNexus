# OpsGaurd Worker agent configuration — safe-by-default.
# Copy to /etc/opsguard/agent-config.yaml on every swarm node and mount it into
# the worker container (see deploy/stack.yml).

worker:
  # auto: derive role from the swarm node (manager -> orchestration+MCP,
  #        worker -> local-only). Pin to manager/node to override.
  role: auto
  # Listen address of the node's local API (and, on managers, the HTTP port for
  # /mcp + /healthz + the management API). Default :8080.
  listen: ":8080"
  # gRPC listen address for the management API (server↔worker), manager-role
  # only. The server connects here and opens SubscribeEvents/SubscribeAudit
  # streams to pull events back (honoring the one-way server→worker network
  # policy). Default :9080. Override via the -grpc-addr flag.
  grpcListen: ":9080"
  # Persistent state directory (event/audit SQLite queues). Default
  # /var/lib/opsguard. Mount it as a volume so events survive restarts.
  dataDir: "/var/lib/opsguard"

# DEPRECATED: monitoring events are now streamed to the server over the gRPC
# SubscribeEvents bidirectional stream (server-initiated), not POSTed to webhook
# URLs. This field is ignored.
# webhooks:
#   - "http://opsguard-web:8080/api/v1/events"

# Bearer-token auth for the HTTP API, MCP endpoint, and the gRPC management
# service. Enable in production — the API can run host commands. Tokens can
# also be distributed centrally via WORKER_TOKENS="name=secret,..." (env),
# which enables auth automatically.
auth:
  enabled: false
  # tokens map a name -> secret; the name becomes the audit actor:
  # tokens:
  #   admin: "change-me"
  #   ops: "change-me-too"

commandPolicy:
  # blacklist: reject commands matching `blacklist` substrings, allow the rest.
  # whitelist: allow only commands starting with a `whitelist` entry.
  mode: blacklist

  # Host command execution (exec_host_command, via nsenter). Requires the
  # worker to run privileged + pid=host. Default OFF — enable explicitly.
  allowHostExec: false

  # Container command execution (exec_in_container).
  allowContainerExec: true

  # Per-command timeout.
  timeout: 30s

  # Blacklist substrings (merged with the built-in dangerous set: rm -rf /,
  # shutdown, reboot, mkfs, dd to /dev/sd*, fork bombs, ...).
  blacklist:
    - "curl http://|sh"
    - "wget http://|sh"

  # Whitelist prefixes (used when mode: whitelist), e.g.:
  # whitelist:
  #   - "cat"
  #   - "ls"
  #   - "ps"
  #   - "df"
  #   - "free"
  #   - "docker ps"
  #   - "docker logs"
  #   - "systemctl status"
