# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# 本地配置与数据
config.local.yaml
OpsGaurdWeb/server/configs/config.local.yaml
OpsGaurdWeb/server/data/

# 离线部署的二进制制品（docker/image tar 包）——不进 git，走 release 附件分发
deploy/offline/bundle/
*.tar
*.tgz

# 离线部署的运行时/集群特定文件（含 worker token、集群地址等，不进 git；
# 仅 deploy/offline/README.md 作为部署 runbook 入仓并保持最新）
deploy/offline/agent-config*.yaml
deploy/offline/stack*.yml
deploy/offline/install-docker*.sh

# 本地部署工作区（交叉编译二进制、重打镜像上下文、上传包等）
.deploytmp/

# K8s 资源转储（排查/方案参考用，非源码）
/k8s-*.json

# ZCode 会话计划（本地工具产物）
.zcode/
